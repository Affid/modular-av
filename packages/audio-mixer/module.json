{
  "id": "modular-av-audio-mixer",
  "title": "Modular A/V: Audio mixer",
  "description": "A mixer for your voice: which effects run, in which order, and how loud. Holds no effects itself: it mixes the effect modules a world has turned on.",
  "authors": [{ "name": "Andrei Fedorov", "url": "https://github.com/Affid" }],
  "url": "https://github.com/Affid/modular-av",
  "bugs": "https://github.com/Affid/modular-av/issues",
  "license": "LICENSE",
  "compatibility": { "minimum": "14", "verified": "14.369" },
  "esmodules": ["modular-av-audio-mixer.js"],
  "languages": [{ "lang": "en", "name": "English", "path": "lang/en.json" }],
  "relationships": {
    "requires": [{ "id": "modular-av", "type": "module" }],
    "recommends": [
      {
        "id": "modular-av-dock",
        "type": "module",
        "reason": "Opens the mixer from the voice panel and the settings window."
      }
    ]
  },
  "flags": {
    "modular-av": {
      "kind": "effect",
      "icon": "fa-solid fa-sliders",
      "facts": [
        { "label": "Who uses it", "value": "Each player, for their own voice" },
        { "label": "Works with", "value": "Every service" }
      ]
    }
  }
}
