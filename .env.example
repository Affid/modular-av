# Copy to .env.local (untracked) and fill in. Never commit real values.

# Local Foundry VTT (scripts/foundry/*)
FOUNDRY_APP_DIR=~/foundry/vtt
FOUNDRY_DATA_DIR=~/foundry/data
FOUNDRY_PORT=30000
FOUNDRY_ADMIN_PASSWORD=

# Windows Chrome started with --remote-debugging-port (see docs/LOCAL-SETUP.md)
CHROME_CDP_URL=http://localhost:9222
