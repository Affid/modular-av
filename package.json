{
  "name": "modular-av-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck && tsc --noEmit -p tools && tsc --noEmit -p scripts && tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lang:check": "node tools/lang/cli.ts",
    "size:check": "node tools/size/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:services": "playwright test -c playwright.services.config.ts",
    "test:services:cloud": "MAV_LIVEKIT=cloud playwright test -c playwright.services.config.ts",
    "test:foundry": "playwright test -c playwright.foundry.config.ts",
    "test:foundry:cloud": "MAV_LIVEKIT=cloud playwright test -c playwright.foundry.config.ts",
    "release:pack": "node tools/release/cli.ts pack",
    "release:publish": "node tools/release/cli.ts publish",
    "foundry:start": "scripts/foundry/start.sh",
    "foundry:link": "node scripts/foundry/link-modules.ts",
    "foundry:setup": "node scripts/foundry/setup-world.ts",
    "foundry:check": "node scripts/foundry/check-world.ts",
    "changeset": "changeset",
    "version:packages": "changeset version && pnpm install --lockfile-only",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm lang:check && pnpm test:coverage && pnpm build && pnpm size:check && pnpm test:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@modular-av/api": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
